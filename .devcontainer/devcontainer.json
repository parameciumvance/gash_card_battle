{
  "build": {
    "dockerfile": "Dockerfile"
  },

  "remoteUser": "dev",

  // 關閉 VS Code 時不停止容器;重新開啟時接上運行中的容器
  "shutdownAction": "none",

  "mounts": [
    "source=gash-card-battle_claude-data,target=/home/dev/.claude,type=volume"
  ],
  "runArgs": ["--memory=3g", "--memory-swap=3584m"],

  // 瀏覽器測試(tests/ 的 browser 標記)需要 playwright 的 Chromium;重建容器後一併安裝
  "postCreateCommand": "sudo chown -R dev:dev /home/dev/.claude && pip install -e \".[dev]\" && python -m playwright install --with-deps chromium-headless-shell",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "mhutchie.git-graph",
        "anthropic.claude-code",
        "openai.chatgpt"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.analysis.indexing": false,
        "typescript.tsserver.maxTsServerMemory": 512
      }
    }
  }
}
